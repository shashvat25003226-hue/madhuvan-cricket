MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/madhuban_cricket?retryWrites=true&w=majority
MONGODB_DB=madhuban_cricket
SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=you@example.com
PUBLIC_ORIGIN=https://your-cricket-app.example.com
PORT=3000
# Optional: Gemini key is server-side only. No unrestricted chatbot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: automated reminders via Resend. Players must opt in.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Required to call scheduled maintenance endpoint.
CRON_SECRET=