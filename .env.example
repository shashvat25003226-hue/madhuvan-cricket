SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=you@example.com
# Required to activate organizer access (secret, at least 16 characters); do NOT commit the value
ADMIN_SETUP_CODE=
PUBLIC_ORIGIN=https://your-cricket-app.example.com
PORT=3000
# Optional: Gemini key is server-side only. No unrestricted chatbot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: automated reminders via Resend. Players must opt in.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=
# Required to call scheduled maintenance endpoint.
CRON_SECRET=